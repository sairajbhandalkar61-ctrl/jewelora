# ==============================================================================
# JEWELORA – ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to server/.env and client/.env before running.
# NEVER commit real credentials to GitHub or public version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND SERVER (server/.env or Render Environment Variables)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=production

# Production Frontend URL (Allowed by CORS in Express)
FRONTEND_URL=https://your-jewelora.vercel.app

# ------------------------------------------------------------------------------
# MYSQL DATABASE (Local XAMPP or Cloud: Aiven, Railway, TiDB, PlanetScale)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=jewelora_db

# Set to true for Cloud MySQL services requiring SSL (Aiven, TiDB, Railway)
DB_SSL=false

# Alternatively, specify a single cloud connection URL (optional):
# DATABASE_URL=mysql://username:password@host:3306/jewelora_db

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# ------------------------------------------------------------------------------
# FRONTEND CLIENT (client/.env or Vercel Environment Variables)
# ------------------------------------------------------------------------------
# In Development: http://localhost:5000
# In Production:  https://your-backend.onrender.com
VITE_API_URL=http://localhost:5000
