# ==============================================================================
# JEWELORA SERVER – ENVIRONMENT CONFIGURATION
# ==============================================================================
PORT=5000
NODE_ENV=development

# Allowed Frontend URL for CORS (In production, set to your Vercel URL)
FRONTEND_URL=http://localhost:5173

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=jewelora_db

# Enable SSL for Cloud MySQL providers (Aiven, TiDB Cloud, Railway)
DB_SSL=false

# Optional connection URI
# DATABASE_URL=mysql://user:password@host:3306/jewelora_db

# JWT Secret Key
JWT_SECRET=jewelora_dev_jwt_secret_key
